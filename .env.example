# Copy to .env for local development (never commit the real file).
# Render sets this directly as an environment variable in the dashboard.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=3000
# 가계부·OPIC·숙제 관리(admin 로그인)가 함께 쓰는 서비스 비밀번호.
# 예전 이름은 HOUSEHOLD_PASSWORD이고 아직 그 이름도 읽는다.
DIRECTORHOME_PASSWORD=change-me
